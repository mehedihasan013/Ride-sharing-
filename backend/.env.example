# Application Port & Env
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cholobhairab?schema=public"

# Redis (Real-time Geo & PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET="cholobhairab_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="30d"

# Barikoi Maps API (Bangladesh Location Services)
BARIKOI_API_KEY="your_barikoi_api_key_here"

# bKash Payment Gateway (Tokenized API)
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_merchant_username"
BKASH_PASSWORD="your_bkash_merchant_password"

# Bangladesh SMS Gateway (Greenweb / BulkSMSBD / SSL Wireless)
SMS_API_KEY="your_sms_api_key"
SMS_SENDER_ID="CholoBhairab"
SMS_ENDPOINT="https://api.greenweb.com.bd/api.php"

# Business & Commission Settings
PLATFORM_COMMISSION_PERCENT=8.0
DRIVER_MIN_WALLET_BALANCE_BDT=50.0
DEFAULT_BID_TIMEOUT_SECONDS=60
DEFAULT_DRIVER_SEARCH_RADIUS_KM=4.0
