# Application Port & Env
PORT=4000
NODE_ENV=development

# Supabase Cloud Database (Project: fmhbugcullfemxtevpxw, region ap-northeast-1 Tokyo)
# Copy the exact pooler host from Supabase Dashboard > Connect and replace [POOLER-HOST]
# (it looks like aws-<n>-ap-northeast-1.pooler.supabase.com). Leave [YOUR-PASSWORD] in place to run on the local disk store.
SUPABASE_URL="https://fmhbugcullfemxtevpxw.supabase.co"
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.fmhbugcullfemxtevpxw:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.fmhbugcullfemxtevpxw:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
# JWT Authentication (required in production; generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="[GENERATE-A-LONG-RANDOM-SECRET]"

# Admin API key (required in production). Sent by the admin dashboard as header x-admin-key
# and as socket.io auth { adminKey }. If unset outside production, admin routes are open.
ADMIN_API_KEY=""

# Comma-separated allowed browser origins (required in production), e.g. https://admin.example.com,https://app.example.com
# Unset = allow any origin (development only).
CORS_ORIGINS=""

# Demo seed data (fake online fleet, demo rides, wallets, KYC and users). Set to false in production.
SEED_DEMO=true

# Public demo server only: re-enables simulate-ride, reset-seed and mock bKash in production.
# Leave unset (or false) for a real launch. Admin key, OTP and CORS protections stay on either way.
DEMO_MODE=false

# Barikoi Maps API (Bangladesh Location Services)
BARIKOI_API_KEY="your_barikoi_api_key_here"

# bKash Payment Gateway (Tokenized Checkout API v1.2.0-beta)
# mock = local fake checkout (development only; refused in production).
# Production: BKASH_MODE="sandbox" with real credentials, the matching BKASH_BASE_URL,
# and an https BKASH_CALLBACK_URL pointing at this backend's /payments/bkash/callback.
BKASH_MODE="mock"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="sandbox_demo_app_key"
BKASH_APP_SECRET="sandbox_demo_app_secret"
BKASH_USERNAME="sandbox_demo_user"
BKASH_PASSWORD="sandbox_demo_pass"
BKASH_CALLBACK_URL="http://localhost:4000/payments/bkash/callback"

# Bangladesh SMS Gateway (not wired yet: OTPs are not sent by SMS until a gateway is chosen)
SMS_API_KEY="your_sms_api_key"
SMS_SENDER_ID="CholoBhairab"
SMS_ENDPOINT="https://api.greenweb.com.bd/api.php"
